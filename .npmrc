# Mid-Atlantic AI — security-conscious npm defaults.
# Documented hardening after the 2025-2026 supply-chain incidents (Shai-Hulud,
# Axios/Sapphire Sleet, Mini Shai-Hulud) — most of which were detected and pulled
# within hours-to-days of publication. A release-age cooldown blocks installation
# during the typical worm propagation window.
min-release-age=10080
audit-level=high
fund=false
