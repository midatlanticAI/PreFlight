# Mid-Atlantic AI — security-conscious npm defaults.
#
# Every worm in the 2025-2026 wave (Shai-Hulud, Axios/Sapphire Sleet, Mini
# Shai-Hulud) propagated through install-time lifecycle scripts, which npm runs
# by default on every dependency in the tree. Turning them off is the single
# highest-value line in this file.
#
# Verified before enabling, because this is the deploy path: a clean
# `npm ci --ignore-scripts` against this lockfile still produces a working
# esbuild 0.21.5, sharp with libvips 8.17.3, rollup and vite 5.4.21. Those are
# the only three packages here that ship native binaries, and all three deliver
# them through platform-specific optional dependencies rather than downloading
# in a script. If a future dependency genuinely needs its build step, allow it
# deliberately with `npm rebuild <pkg>` rather than deleting this line.
ignore-scripts=true

# This file used to carry `min-release-age=10080` with a comment calling it a
# release cooldown. Verified 2026-07-26 against npm 10.9.8: npm does not
# implement that key. Unknown .npmrc keys are echoed back by `npm config ls -l`,
# which is what made it look accepted. The rolling cooldown is a pnpm feature,
# spelled `minimumReleaseAge` and read from pnpm-workspace.yaml, so the line was
# inert twice over. PreFlight's own Package Manager Hardening probe recommended
# it, which made this repo the closed loop in miniature: the tool taught a
# control that does nothing and then certified us for adopting it.
#
# npm's nearest equivalent is `before=<date>`, deliberately not set. It pins
# resolution to a fixed date rather than a rolling window, so it has to be moved
# by hand, and a stale one silently freezes security patches out of the tree as
# well as malicious versions. `npm ci` against a reviewed lockfile covers the
# same ground here without the rot.

audit-level=high
fund=false
